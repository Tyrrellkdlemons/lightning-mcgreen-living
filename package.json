{
  "name": "lightning-mcgreen-living",
  "version": "0.1.0",
  "private": true,
  "description": "California and Arizona living guides, rental and vehicle discovery with protected place-photo galleries.",
  "scripts": {
    "dev": "node scripts/sync-insert-images.mjs && next dev --webpack",
    "build": "next build --webpack",
    "prebuild": "node scripts/sync-insert-images.mjs",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\" \"docs/**/*.md\"",
    "sync-images": "node scripts/sync-insert-images.mjs",
    "import:workbook": "python scripts/import-ranked-workbook.py",
    "import:workbook-full": "python scripts/import-workbook-full.py",
    "check:direct-listings": "node scripts/check-direct-listings.mjs",
    "import:csv": "node scripts/import-csv.mjs",
    "verify:links": "node scripts/verify-links.mjs",
    "add:direct-url": "node scripts/add-direct-url.mjs",
    "set:github-remote": "node scripts/set-github-remote.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "7.0.2",
    "@tanstack/react-query": "^5.28.0",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.8",
    "lucide-react": "1.67.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.5",
    "papaparse": "^5.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.51.1",
    "tailwind-merge": "^2.2.2",
    "zod": "4.6.7",
    "zustand": "^4.5.2",
    "@netlify/blobs": "10.7.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.18",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "8.5.32",
    "prettier": "^3.2.5",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
