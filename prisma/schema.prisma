// Lightning McGreen Living — database schema
// Use Prisma against Postgres + PostGIS in production. Schema mirrors the
// types in src/types/index.ts and the import format in
// docs/MANUAL_DATA_IMPORT_FORMAT.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceKind {
  official
  partner
  public_open_data
  property_or_dealer_website
  manual_verified
  unverified
}

enum TrustLabel {
  official
  partner
  public_open_data
  manual_verified
  unverified
}

enum FreshnessStatus {
  live
  recent
  stale
  manual_review_needed
}

enum RentalUnitType {
  apartment
  townhouse
  townhome_style_apartment
}

enum ApplicationPlatform {
  RentCafe
  Entrata
  AppFolio
  RealPage
  Knock
  Other
  Unknown
}

enum WorkVehicleType {
  cargo_van
  box_truck
  pickup
  stake_bed
  flatbed
  passenger_van
  refrigerated
}

enum VehicleCondition { new used cpo }
enum VehicleAvailability { available pending sold }

model SourceMeta {
  id                       String          @id @default(cuid())
  source                   SourceKind
  source_url               String
  confidence_score         Int
  last_seen_at             DateTime
  last_verified_at         DateTime
  data_freshness_status    FreshnessStatus
  trust_label              TrustLabel

  RentalListing            RentalListing?  @relation(fields: [rental_id], references: [id])
  rental_id                String?
  Dealer                   Dealer?         @relation(fields: [dealer_id], references: [id])
  dealer_id                String?
  VehicleListing           VehicleListing? @relation(fields: [vehicle_id], references: [id])
  vehicle_id               String?
  WorkVehicleRental        WorkVehicleRental? @relation(fields: [work_id], references: [id])
  work_id                  String?
}

model RentalListing {
  id                        String              @id @default(cuid())
  external_id               String              @unique
  property_name             String
  unit_type                 RentalUnitType
  address_line              String
  city                      String
  county                    String
  state                     String              @default("CA")
  zip                       String
  lat                       Float
  lng                       Float
  manager                   String
  application_platform      ApplicationPlatform @default(Unknown)
  application_url           String
  official_property_url     String
  min_rent                  Int
  max_rent                  Int
  beds_min                  Float
  beds_max                  Float
  baths_min                 Float
  baths_max                 Float
  sqft_min                  Int?
  sqft_max                  Int?
  deposit                   Int?
  application_fee           Int?
  admin_fee                 Int?
  pet_policy                String?
  pet_fee                   Int?
  parking_type              String?
  parking_fee               Int?
  income_multiplier         Float?
  screening_vendor          String?
  move_in_specials          String?
  levels                    Int?
  private_entrance          Boolean?
  attached_garage           Boolean?
  yard_or_patio             Boolean?
  lower_density_community   Boolean?
  meta                      SourceMeta[]
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt

  @@index([city])
  @@index([county])
  @@index([unit_type])
}

model Dealer {
  id                          String           @id @default(cuid())
  external_id                 String           @unique
  dealer_name                 String
  legal_name                  String?
  address_line                String
  city                        String
  county                      String
  state                       String           @default("CA")
  zip                         String
  lat                         Float
  lng                         Float
  phone                       String
  website                     String
  dealer_license_number       String?
  inventory_count             Int?
  financing_application_url   String?
  lender_partners             String[]
  google_rating               Float?
  google_review_count         Int?
  promos_json                 Json?
  meta                        SourceMeta[]
  vehicles                    VehicleListing[]
  created_at                  DateTime         @default(now())
  updated_at                  DateTime         @updatedAt
}

model VehicleListing {
  id                          String              @id @default(cuid())
  vin                         String              @unique
  dealer                      Dealer              @relation(fields: [dealer_id], references: [id])
  dealer_id                   String
  year                        Int
  make                        String
  model                       String
  trim                        String?
  mileage                     Int
  price                       Int
  down_payment_estimate       Int?
  apr_estimate                Float?
  term_months                 Int?
  fuel_type                   String?
  drive                       String?
  transmission                String?
  body_type                   String?
  condition                   VehicleCondition
  availability_status         VehicleAvailability
  listing_url                 String
  fuel_economy_mpg_combined   Int?
  safety_rating_overall       Int?
  meta                        SourceMeta[]
  created_at                  DateTime            @default(now())
  updated_at                  DateTime            @updatedAt
}

model WorkVehicleRental {
  id                          String          @id @default(cuid())
  external_id                 String          @unique
  provider_name               String
  legal_name                  String?
  branch_address              String
  city                        String
  county                      String
  state                       String          @default("CA")
  zip                         String
  lat                         Float
  lng                         Float
  phone                       String
  website                     String
  vehicle_type                WorkVehicleType
  daily_rate                  Int?
  weekly_rate                 Int?
  monthly_rate                Int?
  mileage_fee_per_mile        Float?
  included_miles_per_day      Int?
  deposit                     Int?
  insurance_per_day_estimate  Int?
  business_account_available  Boolean?
  min_age                     Int?
  license_required            String?
  payment_required            String?
  one_way_available           Boolean?
  after_hours_pickup          Boolean?
  cargo_volume_cuft           Int?
  payload_lbs                 Int?
  meta                        SourceMeta[]
  created_at                  DateTime        @default(now())
  updated_at                  DateTime        @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actor_email String
  action      String
  target      String
  payload     Json?
  created_at  DateTime @default(now())
}
