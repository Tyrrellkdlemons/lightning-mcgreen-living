# =============================================================================
# Lightning McGreen Living — Environment template
# =============================================================================
# Copy this file to .env.local and fill in only the keys you have.
# The app degrades gracefully: every provider has a "missing key" fallback
# and is clearly labeled in the data-source transparency panel.
# NEVER commit a real .env file.
# =============================================================================

# ---- Mode -------------------------------------------------------------------
# production = default. Demo banner hidden. publishable() guard still filters
#              listings missing full source metadata.
# demo       = legacy. Re-mounts the red disclosure banner on every page.
NEXT_PUBLIC_DATA_MODE=production

# Geofence — keep ON in production. Rendering listings outside the SoCal
# bounding box is blocked when this is true.
NEXT_PUBLIC_GEOFENCE_SOCAL=true

# ---- Database (optional, only needed when you wire up Postgres) -------------
# DATABASE_URL="postgresql://user:password@localhost:5432/lightning_mcgreen?schema=public"

# ---- Cache (optional) -------------------------------------------------------
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# Free, public, no-key required providers (already wired up)
# =============================================================================
# NHTSA vPIC (VIN decode)            — https://vpic.nhtsa.dot.gov/api/
# FuelEconomy.gov                    — https://www.fueleconomy.gov/feg/ws/
# U.S. Census ACS                    — Free; key recommended for higher rate
# HUD Fair Market Rents              — https://www.huduser.gov/portal/dataset/fmr-api.html
# OpenStreetMap / Overpass           — https://overpass-api.de/
# These all work without keys; no env vars required.

# Optional Census API key (raises rate limits; free at https://api.census.gov/data/key_signup.html)
# CENSUS_API_KEY=

# HUD User token (free signup at https://www.huduser.gov/hudapi/public/register)
# HUD_API_TOKEN=

# =============================================================================
# Env-key gated providers (the app works without these — features degrade)
# =============================================================================
# GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=
# MAPLIBRE_STYLE_URL=

# =============================================================================
# Partner-only / paid providers — placeholders only.
# These require contractual approval and are NOT auto-fetched.
# See docs/API_CONNECTOR_STATUS.md for status of each.
# =============================================================================
# ZILLOW_BRIDGE_TOKEN=
# APARTMENTS_COM_PARTNER_KEY=
# RENT_COM_PARTNER_KEY=
# YARDI_RENTCAFE_KEY=
# ENTRATA_API_KEY=
# APPFOLIO_API_KEY=
# REALPAGE_API_KEY=
# CARS_COM_PARTNER_KEY=
# AUTOTRADER_PARTNER_KEY=
# CARGURUS_PARTNER_KEY=
# MARKETCHECK_API_KEY=

# =============================================================================
# Admin
# =============================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_SHARED_SECRET=change-me-in-production-use-a-random-32-char-string
